sequenceDiagram
    actor Admin
    participant Screen as :ShipmentScreen
    participant TNC as :TrackingNotifyController
    participant OrderRepo as :OrderRepository
    participant DB as :DBConnector
    participant MP as Marketplace

    Admin->>Screen: clickSendTracking(orderId)
    Screen->>TNC: sendTrackingNotify(orderId)
    TNC->>OrderRepo: getChannelInfo(orderId)
    OrderRepo->>DB: executeQuery(Q5S.1)
    DB-->>OrderRepo: return channelInfo
    OrderRepo-->>TNC: return channelInfo
    TNC->>TNC: validateTrackingAndCarrierPresent(channelInfo)
    alt missing tracking number or carrier
        TNC-->>Screen: showError("ข้อมูลหมายเลขติดตามไม่ครบถ้วน")
    else fields complete
        TNC->>MP: sendTrackingNumber(marketplaceOrderId, trackingNumber)
        MP-->>TNC: return ackResult
        alt send succeeded
            TNC->>OrderRepo: markTrackingNotified(orderId)
            OrderRepo->>DB: executeQuery(Q5S.2)
            DB-->>OrderRepo: return updateResult
            TNC-->>Screen: showSuccess("แจ้งเลขติดตามให้ลูกค้าสำเร็จ")
            TNC->>TNC: proceedToUseCase7S(orderId)
        else send failed
            TNC-->>Screen: showError("ส่งเลขติดตามไม่สำเร็จ กรุณาลองใหม่ภายหลัง")
        end
    end
