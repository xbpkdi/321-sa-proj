sequenceDiagram
    actor Admin as Super Admin
    participant V as :ReorderScreen (reorder/page.tsx)
    participant C as :ReorderController (actions.ts)
    participant UC as :ReordersUseCase (reorders.ts)
    participant RQ as :ReorderQueries (reorders.ts)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openDecideTab()
    V->>V: showDecisionList(orders, unitCost, sellingPrice, margin)
    Admin->>V: chooseDecision(orderId, decision)
    V->>V: showConfirmDialog(defaultQty)
    Admin->>V: confirmDecision(qty)
    V->>C: decideReorderAction(orderId, decision, qty)
    C->>UC: decideReorderUseCase(input)
    alt qty ไม่ใช่จำนวนเต็มบวก
        UC-->>C: return "invalid-qty"
    else qty ถูกต้อง
        UC->>RQ: lockDecisionContext(client, orderId)
        RQ->>DB: query(Q5A.1)
        DB-->>RQ: return row
        RQ-->>UC: return row
        alt รอดำเนินการด้วยตนเอง และ manual_reason = price
            UC-->>C: return "no-price"
        else สถานะไม่ใช่ รอ Admin ตัดสินใจสั่งซื้อ
            UC-->>C: return "not-pending"
        else ไม่มี selling_price
            UC->>RQ: markDecisionMissingPrice(client, orderId)
            RQ->>DB: query(Q5A.3)
            DB-->>RQ: return ok
            UC-->>C: return "no-price"
        else ไม่มี unit_cost
            UC-->>C: return "no-cost"
        else fault db
            UC-->>C: return "db"
        else ข้อมูลครบ
            UC->>RQ: saveReorderDecision(client, decision, qty, status)
            RQ->>DB: query(Q5A.2)
            DB-->>RQ: return ok
            RQ-->>UC: return ok
            UC-->>C: return "ok"
        end
    end
    C-->>V: return result
    alt result = ok และ คุ้มค่า
        V->>V: showSuccess("บันทึกผลสำเร็จ ส่ง Order เข้าสู่การสั่งซื้อจาก Supplier")
    else result = ok และ ไม่คุ้มค่า
        V->>V: showSuccess("บันทึกผลสำเร็จ ส่ง Order เข้าสู่การยกเลิก Order")
    else result อื่น
        V->>V: showError(message)
    end
