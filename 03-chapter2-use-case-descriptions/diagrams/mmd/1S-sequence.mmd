sequenceDiagram
    actor Admin as Super Admin
    participant V as :RslMatchScreen (rsl-match/page.tsx)
    participant C as :RslMatchController (actions.ts)
    participant UC as :MatchOrderUseCase (match-order.ts)
    participant WF as :ExecuteWorkflow (execute-workflow.ts)
    participant OQ as :OrderQueries (orders.ts)
    participant RSL as :RslAdapter (adapters)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openRslMatchPage()
    V->>V: showUnmatchedOrders()
    alt match all
        Admin->>V: clickMatchAll()
        V->>C: matchAllRslAction()
        C->>UC: matchAllRslUseCase()
        UC->>OQ: listRslQueueIds()
        OQ->>DB: query(Q1S.1)
        DB-->>OQ: return orderIds
        OQ-->>UC: return orderIds
    else one Order
        Admin->>V: clickMatch(orderId, chosen)
        V->>C: matchRslAction(orderId, chosen)
    end
    C->>UC: matchRslUseCase(orderId, chosen)
    UC->>OQ: lockOrder(orderId)
    OQ->>DB: query(Q1S.2)
    DB-->>OQ: return order
    OQ-->>UC: return order
    break in-house Order (fulfill_source = in_house) or wrong status
        UC-->>C: return not-allowed
    end
    UC->>RSL: matchOrder(sku, variation)
    alt connection failed
        RSL-->>UC: return error
        UC-->>C: return connection
    else candidates
        RSL-->>UC: return matches
        UC->>UC: chooseRslMatch(matches, chosen)
        alt not found
            UC->>OQ: saveRslMatch(orderId, null, "รอดำเนินการด้วยตนเอง", "rsl")
            OQ->>DB: query(Q1S.3)
            UC-->>C: return not-found
        else multiple
            UC-->>C: return multiple(options)
        else matched
            UC->>WF: executeWorkflow(saveMatch, orderIds)
            WF->>OQ: lockOrder(orderId)
            OQ->>DB: query(Q1S.2)
            WF->>OQ: saveRslMatch(orderId, rslNo, "รอจัดรูปแบบใบปะสินค้า", null)
            OQ->>DB: query(Q1S.3)
            WF->>WF: runAutomation(orderIds) [UC 6S]
            WF-->>UC: return committed
            UC-->>C: return ok(reference)
        end
    end
    C-->>V: return result
    alt multiple
        V->>V: showChooseDialog("พบข้อมูล RSL ที่ตรงกันมากกว่า 1 รายการ")
    else not found
        V->>V: showError("ไม่พบสินค้านี้ในระบบ RSL")
    else connection
        V->>V: showError("ไม่สามารถเชื่อมต่อกับระบบ RSL ได้")
    else ok
        V->>V: showSuccess("จับคู่ Order กับ RSL สำเร็จ")
    end
    opt unmatch
        Admin->>V: clickUnmatch(orderId)
        V->>C: unmatchRslAction(orderId)
        C->>UC: unmatchRslUseCase(orderId)
        UC->>OQ: lockOrder(orderId)
        OQ->>DB: query(Q1S.2)
        UC->>OQ: clearRslMatch(orderId)
        OQ->>DB: query(Q1S.4)
        DB-->>OQ: return orderId
        OQ-->>UC: return true
        UC-->>C: return true
        C-->>V: return true
        V->>V: showSuccess("ยกเลิกการจับคู่ [Order ID] แล้ว")
    end
