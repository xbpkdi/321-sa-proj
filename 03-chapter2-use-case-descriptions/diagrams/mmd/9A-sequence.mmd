sequenceDiagram
    actor Admin as Super Admin
    participant V as :LabelPrintScreen (label/page.tsx)
    participant C as :LabelPrintController (actions.ts)
    participant UC as :PrintLabelUseCase (print-label.ts)
    participant SQ as :ShippingQueries (shipping.ts)
    participant Printer as :PrinterAdapter (adapters)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openLabelPage()
    V->>C: formatLabelsAction()
    Note over C: run UC 6S ก่อน
    V->>C: loadAppState()
    C->>SQ: listLabels()
    SQ->>DB: query(Q9A.1)
    DB-->>SQ: return labels
    SQ-->>C: return labels
    C-->>V: return state
    V->>V: showPrintQueue()
    Admin->>V: clickPrint(orderIds)
    V->>C: printLabelsAction(orderIds, reprint)
    C->>UC: printLabelsUseCase(orderIds, reprint, adminId)
    loop each Order
        UC->>UC: printLabelUseCase(orderId, reprint, adminId)
        UC->>SQ: listPrintableLabels(orderId)
        SQ->>DB: query(Q9A.2)
        DB-->>SQ: return labels
        SQ-->>UC: return labels
        alt no labels or wrong status
            UC-->>C: return no-template
        else address incomplete
            UC-->>C: return no-address
        else already printed and not reprint
            UC-->>C: return already
        else ready to print
            loop each label by parcel_seq
                UC->>Printer: printLabel(label, attemptId)
                Printer-->>UC: return ok or error
            end
            loop each printed label
                UC->>SQ: recordPrintAttempt(attemptId, labelId, adminId, reprint, outcome)
                SQ->>DB: query(Q9A.3)
            end
            opt all printed and not reprint
                UC->>SQ: completeLabelPrint(orderId)
                SQ->>DB: query(Q9A.4)
            end
            UC-->>C: return ok or printer
        end
    end
    C-->>V: return results
    alt already
        V->>V: showReprintDialog("Order นี้พิมพ์ใบปะสินค้าไปแล้ว ต้องการพิมพ์ซ้ำหรือไม่")
    else printer error
        V->>V: showError("พิมพ์ใบปะสินค้าไม่สำเร็จ กรุณาตรวจสอบเครื่องพิมพ์")
    else ok
        V->>V: showSuccess("ส่งใบปะสินค้า [Order ID] ไปยังเครื่องพิมพ์แล้ว")
    end
