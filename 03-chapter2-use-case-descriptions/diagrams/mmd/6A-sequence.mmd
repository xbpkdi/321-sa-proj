sequenceDiagram
    actor Admin
    participant Sched as Scheduler
    participant POC as :PurchaseOrderController
    participant StockRepo as :StockRepository
    participant SupRepo as :SupplierRepository
    participant PORepo as :PurchaseOrderRepository
    participant DB as :DBConnector
    participant Sup as Supplier

    Sched->>POC: checkReorderThreshold()
    POC->>StockRepo: getLowStockSkus()
    StockRepo->>DB: executeQuery(selectLowStock)
    DB-->>StockRepo: return skuList
    StockRepo-->>POC: return skuList
    POC-->>Admin: displayReorderList(skuList)

    Admin->>POC: confirmPurchase(sku)
    POC->>SupRepo: checkSupplierConfig(sku)
    SupRepo-->>POC: return configExists
    alt Supplier/Reorder Qty not configured
        POC-->>Admin: showError("ไม่พบข้อมูล Supplier หรือจำนวนสั่งซื้อ")
        POC->>PORepo: setManualReview(sku)
    else configuration complete
        POC->>SupRepo: getSupplierInfo(sku)
        SupRepo->>DB: executeQuery(Q7.1)
        DB-->>SupRepo: return supplierInfo
        SupRepo-->>POC: return supplierInfo
        POC->>PORepo: createPurchaseOrder(sku, supplierId, orderQty)
        PORepo->>DB: executeQuery(Q7.2)
        DB-->>PORepo: return poId
        PORepo-->>POC: return poId
        POC->>Sup: sendPurchaseOrder(poId)
        POC-->>Admin: showSuccess("สั่งซื้อแล้ว พร้อมวันที่คาดว่าจะได้รับ")
    end
