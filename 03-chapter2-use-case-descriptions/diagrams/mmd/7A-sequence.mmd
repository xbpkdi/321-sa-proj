sequenceDiagram
    actor Admin as Super Admin
    participant V as :CancelOrderScreen (cancel/page.tsx)
    participant C as :CancelOrderController (actions.ts)
    participant UC as :CancelOrderUseCase (cancel-order.ts)
    participant OQ as :OrderQueries (orders.ts)
    participant STQ as :StockQueries (stock.ts)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openCancelList()
    V->>V: showOrders(status filter, search)
    Admin->>V: clickCancel(orderId)
    V->>V: checkCancel(state, orderId)
    alt จัดส่งสำเร็จ หรือ ยกเลิกแล้ว
        V->>V: showError(message)
    else ยกเลิกได้
        V->>V: showCancelDialog(linkedPo)
        Admin->>V: confirmCancel(reason, alsoCancelPo)
        V->>C: cancelOrderAction(orderId, reason, alsoCancelPo)
        C->>UC: cancelOrderUseCase(input)
        alt reason ว่าง
            UC-->>C: return no-reason
        else มีเหตุผล
            UC->>OQ: lockOrder(client, orderId)
            OQ->>DB: query(Q7A.1)
            DB-->>OQ: return order
            OQ-->>UC: return order
            alt ไม่พบ หรือ จัดส่งสำเร็จ
                UC-->>C: return closed
            else ยกเลิกแล้ว
                UC-->>C: return already(cancelled_at)
            else ส่งมอบ Delivery แล้ว
                UC->>OQ: saveCancellation(client, orderId, "รอดำเนินการพิเศษ", reason, null)
                OQ->>DB: query(Q7A.2)
                UC-->>C: return in-transit
            else ยังไม่ส่งมอบ
                opt stock_deducted = true
                    UC->>STQ: restoreCancelledOrderStock(client, orderId, skuId, source, qty)
                    STQ->>DB: query(Q7A.3)
                    DB-->>STQ: return qty
                    STQ-->>UC: return restocked
                end
                opt alsoCancelPo และมี reorder_id
                    UC->>OQ: cancelLinkedReorder(client, reorderId, orderId)
                    OQ->>DB: query(Q7A.4)
                    DB-->>OQ: return reorderId
                    opt ยกเลิกคำสั่งซื้อสำเร็จ (ยังไม่ได้รับสินค้า)
                        OQ->>DB: query(Q7A.5)
                    end
                    OQ-->>UC: return poCancelled
                end
                UC->>OQ: saveCancellation(client, orderId, "ยกเลิกแล้ว", reason, now)
                OQ->>DB: query(Q7A.2)
                UC-->>C: return ok(labelPrinted, restocked, poCancelled)
            end
        end
        C-->>V: return result
        alt ok
            V->>V: showSuccess("ยกเลิก Order สำเร็จ")
        else in-transit
            V->>V: showError("Order อยู่ระหว่างจัดส่ง บันทึกคำขอเป็น รอดำเนินการพิเศษ")
        else no-reason, closed หรือ already
            V->>V: showError(message)
        end
    end
