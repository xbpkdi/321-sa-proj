sequenceDiagram
    actor Admin as Super Admin
    participant V as :CostScreen (cost/page.tsx)
    participant C as :CostController (actions.ts)
    participant UC as :CostsUseCase (costs.ts)
    participant SQ as :SkuQueries (skus.ts)
    participant CQ as :CostQueries (costs.ts)
    participant HQ as :CostHistoryQueries (cost-history.ts)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openCostPage()
    V->>C: loadAppState()
    C->>CQ: listCosts()
    CQ->>DB: query(Q4S.1)
    DB-->>CQ: return costs
    CQ-->>C: return costs
    C->>HQ: listCostHistory()
    HQ->>DB: query(Q4S.2)
    DB-->>HQ: return history
    HQ-->>C: return history
    C-->>V: return state
    V->>V: showProductList()
    Admin->>V: selectProduct(sku)
    V->>V: showCostForm(savedComponents, history)
    opt exchange_rate_updated_at เกิน 24 ชั่วโมง
        V->>V: showWarning("อัตราแลกเปลี่ยนอาจไม่เป็นปัจจุบัน")
    end
    Admin->>V: calculate(form, remember)
    V->>C: calculateCostAction(sku, form, remember)
    C->>UC: calculateCostUseCase(input)
    UC->>UC: saveCostDraft(client, input)
    UC->>SQ: lockSku(client, sku)
    SQ->>DB: query(Q4S.3)
    DB-->>SQ: return sku
    SQ-->>UC: return sku
    UC->>UC: parseCostForm(sku, form)
    alt exchange_rate ว่าง หรือ ค่าไม่ถูกต้อง
        UC-->>C: return no-rate / invalid
    else ค่าครบถ้วน
        UC->>CQ: lockCost(client, skuId)
        CQ->>DB: query(Q4S.4)
        DB-->>CQ: return current
        CQ-->>UC: return current
        UC->>UC: calcUnitCost(values)
        opt remember = true
            UC->>CQ: saveCost(client, cost, unitCost)
            CQ->>DB: query(Q4S.5)
            DB-->>CQ: return costId
            CQ-->>UC: return costId
        end
        UC->>HQ: insertCostHistory(client, previous, next)
        HQ->>DB: query(Q4S.6)
        UC->>CQ: getSkuSellingPrice(client, skuId)
        CQ->>DB: query(Q4S.7)
        DB-->>CQ: return price
        CQ-->>UC: return price
        UC-->>C: return ok(unit_cost, components, overPrice)
    end
    C-->>V: return result
    alt ok
        V->>V: showResult(unitCost, margin, comparison)
        opt overPrice
            V->>V: showWarning("ต้นทุนต่อหน่วยสูงกว่าราคาขาย")
        end
    else no-rate
        V->>V: showError("ไม่พบอัตราแลกเปลี่ยนล่าสุด กรุณาระบุด้วยตนเอง")
    else invalid
        V->>V: showError("กรุณากรอกข้อมูลต้นทุนให้ครบถ้วนและถูกต้อง")
    end
