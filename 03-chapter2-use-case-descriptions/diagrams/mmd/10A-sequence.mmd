sequenceDiagram
    actor Admin as Super Admin
    participant V as :CleanupScreen (cleanup/page.tsx)
    participant C as :CleanupController (actions.ts)
    participant UC as :CleanupOrdersUseCase (cleanup-orders.ts)
    participant CQ as :CleanupQueries (cleanup.ts)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openCleanupPage()
    V->>V: showTabs("ลบตามช่วงวันที่", "ลบ Order ที่ปิดแล้ว")
    alt ลบตามช่วงวันที่
        Admin->>V: selectTypes(types), selectCutoff(date), clickReview()
        alt ไม่เลือกประเภท
            V->>V: showError("กรุณาเลือกประเภทข้อมูลที่ต้องการลบ")
        else วันที่ไม่ถึง 12 เดือน
            V->>V: showError("สามารถลบข้อมูลที่เก่ากว่า 12 เดือนเท่านั้น")
        else ค่าถูกต้อง
            V->>V: planRangeCleanup(state, types, cutoff)
        end
    else ลบ Order ที่ปิดแล้ว
        Admin->>V: clickReviewClosed()
        V->>V: planClosedCleanup(state)
    end
    alt ไม่พบข้อมูลที่ลบได้
        V->>V: showError("ไม่พบข้อมูลที่ลบได้")
    else พบข้อมูล
        V->>V: showReview(items, blocked)
        opt สำรองข้อมูลก่อนลบ
            Admin->>V: clickBackup()
            V->>V: downloadCsv()
        end
        Admin->>V: clickConfirmDelete()
        V->>C: cleanupOrdersAction(items)
        C->>UC: cleanupOrdersUseCase(items, adminId)
        loop แต่ละรายการ (Order ก่อน)
            alt Order
                UC->>CQ: deleteClosedOrder(orderId, historyId, adminId)
                CQ->>DB: query(Q10A.1)
            else Label
                UC->>CQ: deleteClosedLabels(orderId)
                CQ->>DB: query(Q10A.2)
            else Cost
                UC->>CQ: deleteHistoricalCost(sku@changedAt)
                CQ->>DB: query(Q10A.3)
            else Reorder
                UC->>CQ: deleteFinishedReorder(reorderId)
                CQ->>DB: query(Q10A.4)
            end
            DB-->>CQ: return rowCount
            CQ-->>UC: return removed
        end
        alt ฐานข้อมูลขัดข้อง
            UC-->>C: throw error (rollback ทั้งชุด)
            C-->>V: return databaseError
            V->>V: showError(databaseError)
        else สำเร็จ
            UC-->>C: return deleted, skipped
            C-->>V: return result
            V->>C: loadAppState()
            C->>CQ: listDeletionHistory()
            CQ->>DB: query(Q10A.5)
            DB-->>CQ: return history
            CQ-->>C: return history
            C-->>V: return state
            V->>V: showSuccess("ลบข้อมูลสำเร็จ [n] รายการ")
            opt มีรายการที่ลบไม่ได้หรือถูกข้าม
                V->>V: showWarning("ไม่สามารถลบข้อมูลนี้ได้ เนื่องจากยังมีรายการที่เกี่ยวข้อง")
            end
        end
    end
