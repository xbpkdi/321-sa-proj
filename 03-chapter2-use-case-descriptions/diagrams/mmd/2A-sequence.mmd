sequenceDiagram
    actor Admin as Super Admin
    participant V as :OrderVerifyScreen (verify/page.tsx)
    participant C as :OrderVerifyController (actions.ts)
    participant UC as :VerifyOrderUseCase (verify-order.ts)
    participant WF as :ExecuteWorkflow (execute-workflow.ts)
    participant OQ as :OrderQueries (orders.ts)
    participant MP as :RakutenAdapter (adapters)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openVerifyPage()
    V->>C: loadAppState()
    C->>OQ: listOrders()
    OQ->>DB: query(Q2A.1)
    DB-->>OQ: return orders
    OQ-->>C: return orders
    C-->>V: return state
    V->>V: showOrdersWaitingVerify()
    Admin->>V: selectOrder(order_id)
    V->>V: showOrderDetail()
    Admin->>V: clickConfirm(order_id, shipping_method)
    V->>C: verifyOrderAction(orderId, shippingMethod)
    C->>UC: verifyOrderUseCase(orderId, shippingMethod, adminId)
    UC->>OQ: lockOrder(orderId)
    OQ->>DB: query(Q2A.2)
    DB-->>OQ: return snapshot
    OQ-->>UC: return snapshot
    alt status is not รอตรวจสอบคำสั่งซื้อ
        UC-->>C: return already
    else waiting verify
        UC->>MP: fetchOrderState(marketplace_order_id)
        MP-->>UC: return latest
        alt RMS unavailable
            UC-->>C: return marketplace
        else data incomplete
            UC->>OQ: saveVerifiedOrder(รอดำเนินการด้วยตนเอง, incomplete)
            OQ->>DB: query(Q2A.3)
            UC-->>C: return incomplete
        else qty not positive
            UC-->>C: return qty
        else customer cancelled
            UC->>OQ: saveVerifiedOrder(ยกเลิกแล้ว)
            OQ->>DB: query(Q2A.3)
            UC-->>C: return customer-cancelled
        else data valid
            UC->>WF: executeWorkflow(work, orderIds)
            WF->>OQ: lockOrder(orderId)
            OQ->>DB: query(Q2A.2)
            WF->>OQ: saveVerifiedOrder(รอจับคู่กฎ SKU, verified_at)
            OQ->>DB: query(Q2A.3)
            WF->>WF: runAutomation() [UC 2S ต่อ]
            WF-->>UC: return done
            UC-->>C: return ok
        end
    end
    C-->>V: return result
    alt already
        V->>V: showError("Order นี้ผ่านการตรวจสอบไปแล้ว")
    else marketplace
        V->>V: showError("ไม่สามารถตรวจสอบข้อมูลล่าสุดจาก Marketplace ได้")
    else incomplete
        V->>V: showError("ข้อมูลคำสั่งซื้อไม่ครบถ้วน กรุณาตรวจสอบ")
    else qty
        V->>V: showError("จำนวนสินค้าต้องมากกว่า 0")
    else customer-cancelled
        V->>V: showError("Order นี้ถูกยกเลิกจากฝั่งลูกค้าแล้ว")
    else ok
        V->>V: showSuccess("ยืนยันคำสั่งซื้อสำเร็จ")
    end
