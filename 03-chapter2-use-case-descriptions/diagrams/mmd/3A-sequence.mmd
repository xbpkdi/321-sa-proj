sequenceDiagram
    actor Admin
    participant Screen as :ProductScreen
    participant PC as :ProductController
    participant ProdRepo as :ProductRepository
    participant SkuRepo as :SkuRuleRepository
    participant DB as :DBConnector

    Admin->>Screen: openProductList()
    Screen-->>Admin: displayProductList()
    Admin->>Screen: clickAddOrEditProduct()
    Screen-->>Admin: showProductForm()

    Admin->>Screen: submitProductForm(productData)
    Screen->>PC: saveProduct(productData)
    PC->>PC: validateNotEmpty(productName, sku)
    alt product name or SKU empty
        PC-->>Screen: showError("กรุณากรอกข้อมูลให้ครบถ้วน")
    else fields provided
        PC->>ProdRepo: checkSkuExists(sku)
        ProdRepo->>DB: executeQuery(Q3A.1)
        DB-->>ProdRepo: return exists
        alt duplicate SKU
            PC-->>Screen: showError("SKU นี้มีอยู่ในระบบแล้ว")
        else SKU unique
            PC->>PC: validatePositiveInteger(reorderThreshold, reorderQty)
            alt not a positive integer
                PC-->>Screen: showError("กรุณากรอกข้อมูลให้ครบถ้วน")
            else all validations passed
                alt add new product
                    PC->>ProdRepo: insertProduct(productData)
                    ProdRepo->>DB: executeQuery(Q3A.2)
                else edit existing product
                    PC->>ProdRepo: updateProduct(productData)
                    ProdRepo->>DB: executeQuery(Q3A.3)
                end
                DB-->>ProdRepo: return result
                ProdRepo-->>PC: return result
                opt Admin sets channel SKU mapping
                    PC->>SkuRepo: insertSkuRule(channelSku, sku)
                    SkuRepo->>DB: executeQuery(Q3A.4)
                end
                PC-->>Screen: showSuccess("บันทึกข้อมูลสินค้าสำเร็จ")
                opt เข้ามาจาก 2S (ไม่พบกฎ SKU เดิม)
                    PC->>PC: retryUseCase2S(sku)
                end
            end
        end
    end
