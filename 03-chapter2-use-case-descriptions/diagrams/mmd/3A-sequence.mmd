sequenceDiagram
    actor Admin as Super Admin
    participant V as :ProductScreen (products/page.tsx)
    participant C as :ProductController (actions.ts)
    participant UC as :ProductsUseCase (products.ts)
    participant WF as :ExecuteWorkflow (execute-workflow.ts)
    participant SQ as :SkuQueries (skus.ts)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openProductList()
    V->>C: loadAppState()
    C->>SQ: listSkus()
    SQ->>DB: query(Q3A.1)
    C->>SQ: listSuppliers()
    SQ->>DB: query(Q3A.2)
    DB-->>SQ: return rows
    SQ-->>C: return skus, suppliers
    C-->>V: return state
    V->>V: showProductList()
    Admin->>V: clickAddOrEditProduct()
    V->>V: showProductForm()
    Admin->>V: submitProductForm(product, costForm)
    V->>C: saveProductAction(draft, originalSku, costForm)
    C->>UC: saveProductUseCase(draft, originalSku, costForm, adminId)
    UC->>UC: validateProduct(draft)
    alt required field empty
        UC-->>C: return incomplete
    else threshold or qty not positive integer
        UC-->>C: return invalid-number
    else valid
        opt edit existing product
            UC->>SQ: lockSku(originalSku)
            SQ->>DB: query(Q3A.3)
        end
        UC->>SQ: findSkuConflict(sku, channel_sku, sku_id)
        SQ->>DB: query(Q3A.4)
        DB-->>SQ: return conflict
        SQ-->>UC: return conflict
        alt duplicate SKU or channel_sku
            UC-->>C: return duplicate
        else unique
            UC->>SQ: supplierExists(supplier_id)
            SQ->>DB: query(Q3A.5)
            alt add new product
                UC->>SQ: insertSku(product, skuId, stockId)
                SQ->>DB: query(Q3A.6)
            else edit existing product
                UC->>SQ: updateSku(skuId, product)
                SQ->>DB: query(Q3A.7)
            end
            UC->>UC: saveCostDraft(sku, costForm) [UC 4S]
            UC->>SQ: requeueOrdersForSku(skuId, sku, channelSku)
            SQ->>DB: query(Q3A.8)
            DB-->>SQ: return requeued
            SQ-->>UC: return requeuedOrderIds
            opt มี Order คืนคิว
                UC->>WF: runAutomation(requeuedOrderIds) [UC 2S, 3S, 6S ต่อ]
                WF-->>UC: return done
            end
            UC-->>C: return ok, requeued
        end
    end
    C-->>V: return result
    alt incomplete
        V->>V: showError("กรุณากรอกข้อมูลให้ครบถ้วน")
    else invalid-number
        V->>V: showError("Reorder Threshold และ Reorder Quantity ต้องเป็นจำนวนเต็มบวก")
    else duplicate
        V->>V: showError("SKU นี้มีอยู่ในระบบแล้ว")
    else ok
        V->>V: showSuccess("บันทึกข้อมูลสินค้าสำเร็จ")
    end
    opt toggle เปิดขาย / ปิดการขาย
        Admin->>V: toggleActive(sku)
        V->>C: setProductActiveAction(sku, active)
        C->>UC: setProductActiveUseCase(sku, active)
        UC->>SQ: lockSku(sku)
        SQ->>DB: query(Q3A.3)
        UC->>SQ: setSkuStatus(skuId, active)
        SQ->>DB: query(Q3A.9)
        UC-->>C: return ok
        C-->>V: return result
        V->>V: showProductList()
    end
    opt delete product
        Admin->>V: clickDelete(sku)
        V->>C: deleteProductAction(sku)
        C->>UC: deleteProductUseCase(sku)
        UC->>SQ: lockSku(sku)
        SQ->>DB: query(Q3A.3)
        UC->>SQ: skuHasRelatedRecords(skuId)
        SQ->>DB: query(Q3A.10)
        alt has related Order or reorder
            UC-->>C: return has-related
            C-->>V: return result
            V->>V: showError("ไม่สามารถลบสินค้านี้ได้")
        else no related record
            UC->>SQ: deleteSku(skuId)
            SQ->>DB: query(Q3A.11)
            UC-->>C: return ok
            C-->>V: return result
            V->>V: showSuccess("ลบสินค้า [SKU] แล้ว")
        end
    end
    opt import CSV
        Admin->>V: uploadCsv(csv)
        V->>C: importProductsAction(csv)
        C->>UC: importProductsUseCase(csv, adminId)
        UC->>UC: saveProductInTransaction(row) [Q3A.3-8 ทีละแถว]
        UC->>WF: runAutomation(requeuedOrderIds) [UC 2S, 3S, 6S ต่อ]
        UC-->>C: return rowResults
        C-->>V: return result
        V->>V: showImportResult(rows)
    end
