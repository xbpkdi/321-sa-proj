sequenceDiagram
    actor Admin as Super Admin
    participant V as :DashboardScreen (dashboard/page.tsx)
    participant C as :DashboardController (actions.ts)
    participant UC as :ImportOrdersUseCase (import-orders.ts)
    participant DQ as :DashboardQueries (dashboard.ts)
    participant OQ as :OrderQueries (orders.ts)
    participant MP as :RakutenAdapter (adapters)
    participant DB as :DBConnector (db.ts)

    Admin->>V: openDashboard()
    V->>C: loadAppState()
    C->>DQ: getDashboardData()
    DQ->>DB: query(Q4A.1)
    DQ->>DB: query(Q4A.2)
    DQ->>DB: query(Q4A.3)
    DB-->>DQ: return totals, volume, recent
    DQ-->>C: return dashboard
    C-->>V: return state
    V->>V: showDashboard()
    Admin->>V: clickImportOrders()
    V->>C: importOrdersAction()
    C->>UC: importOrdersUseCase()
    UC->>MP: fetchOrders()
    MP-->>UC: return orders, cancellationRequests
    alt RMS unavailable
        UC-->>C: return ok=false
        C-->>V: return result
        V->>V: showError("ไม่สามารถเชื่อมต่อกับ Rakuten Ichiba ได้")
    else batch received
        loop each order
            UC->>UC: isImportableOrder(order)
            alt data incomplete
                UC->>UC: skip (incomplete += 1)
            else data complete
                UC->>OQ: findSkuRules(channel_sku, sales_channel)
                OQ->>DB: query(Q4A.4)
                DB-->>OQ: return rules
                OQ-->>UC: return rules
                UC->>UC: chooseSkuRule(rules)
                UC->>OQ: insertImportedOrder(order, status, manualReason)
                OQ->>DB: query(Q4A.5)
                DB-->>OQ: return inserted or conflict
                OQ-->>UC: return inserted
            end
        end
        loop each cancellation request
            UC->>OQ: markMarketplaceCancellation(marketplace_order_id)
            OQ->>DB: query(Q4A.6)
        end
        UC-->>C: return imported, duplicates, incomplete, unregistered
        C-->>V: return result
        V->>V: showResult("นำเข้า Order สำเร็จ n รายการ")
        opt SKU not registered
            V->>V: showWarning("พบ SKU ที่ยังไม่ได้ลงทะเบียนในระบบ")
        end
        opt cancel requested after verify
            V->>V: showWarning("ลูกค้ายกเลิก กรุณาตรวจสอบที่หน้ายกเลิก Order")
        end
    end
