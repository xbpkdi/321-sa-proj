%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class BaseScreen {
        <<abstract>>
        #showSuccess()
        #showError()
    }
    class BaseController {
        <<abstract>>
        #currentUser: User
        #validate()
    }
    class BaseRepository {
        <<abstract>>
        #db: DBConnector
        #executeQuery(queryId, params)
    }
    class DashboardScreen {
        -controller
        -messages: string[]
        +clickImportOrders()
    }
    class OrderIntakeController {
        -orderRepository: OrderRepository
        +addWarning()
        +importOrders()
        +skipOrder()
        +validateRequiredFields()
    }
    class SkuMatchController {
        -orderRepository: OrderRepository
        -skuRuleRepository: SkuRuleRepository
        +proceedToUseCase3S()
        +processPendingSkuMatch()
    }
    class OrderRepository {
        -db: DBConnector
        -table: string = "orders"
        +bindSkuRuleAndUpdateStatus()
        +checkAlreadyPrinted()
        +checkDuplicate()
        +checkLabelStatus()
        +checkStatus()
        +deleteClosedOrders()
        +deleteRecords()
        +getChannelInfo()
        +getClosedOrders()
        +getCostAndMarginInfo()
        +getDeletableRecords()
        +getOrderDetail()
        +getOrdersByStatus()
        +getShippingInfo()
        +getStatus()
        +linkOrders()
        +markPendingSync()
        +markStockDeductedAndCompleted()
        +markTrackingNotified()
        +saveOrder()
        +saveRslMatch()
        +setManualReview()
        +updateDispatched()
        +updateOrderStatus()
        +updateStatus()
        +updateStatusCancelled()
        +updateStatusIfChanged()
    }
    class SkuRuleRepository {
        -db: DBConnector
        -table: string = "sku_rules"
        +findRuleByChannelSku()
        +insertSkuRule()
    }
    class DBConnector {
        -pool: Pool
        +executeQuery()
    }
    BaseScreen <|-- DashboardScreen
    BaseController <|-- OrderIntakeController
    BaseController <|-- SkuMatchController
    BaseRepository <|-- OrderRepository
    BaseRepository <|-- SkuRuleRepository
    BaseRepository o-- DBConnector : db
    DashboardScreen "1" --> "1" OrderIntakeController : uses
    OrderIntakeController ..> OrderRepository
    SkuMatchController ..> OrderRepository
    SkuMatchController ..> SkuRuleRepository
