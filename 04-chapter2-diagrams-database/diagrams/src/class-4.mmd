%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class ProductScreen {
        <<Screen>>
        +clickAddOrEditProduct()
        +clickDelete()
        +openProductList()
        +showError()
        +showImportResult()
        +showProductForm()
        +showProductList()
        +showSuccess()
        +submitProductForm()
        +toggleActive()
        +uploadCsv()
    }
    class ProductController {
        <<Controller>>
        +deleteProductAction()
        +importProductsAction()
        +loadAppState()
        +saveProductAction()
        +setProductActiveAction()
    }
    class ExecuteWorkflow {
        -client: PoolClient
        +runAutomation()
    }
    class ProductsUseCase {
        -client: PoolClient
        +deleteProductUseCase()
        +importProductsUseCase()
        +saveCostDraft()
        +saveProductInTransaction()
        +saveProductUseCase()
        +setProductActiveUseCase()
        +validateProduct()
    }
    class SkuQueries {
        <<module>>
        +Q3A_1: SQL
        +Q3A_1_DELETE: SQL
        +Q3A_1_FIND_CONFLICT: SQL
        +Q3A_1_FOR_UPDATE: SQL
        +Q3A_1_HAS_RELATED: SQL
        +Q3A_1_INSERT: SQL
        +Q3A_1_REQUEUE: SQL
        +Q3A_1_SET_STATUS: SQL
        +Q3A_1_UPDATE: SQL
        +Q6A_2: SQL
        +Q6A_2_SUPPLIER_EXISTS: SQL
        +deleteSku()
        +findSkuConflict()
        +insertSku()
        +listSkus()
        +listSuppliers()
        +lockSku()
        +requeueOrdersForSku()
        +setSkuStatus()
        +skuHasRelatedRecords()
        +supplierExists()
        +updateSku()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    ProductScreen "1" --> "1" ProductController : calls
    ProductController ..> ProductsUseCase
    ProductController ..> SkuQueries
    ProductsUseCase ..> ExecuteWorkflow
    ProductsUseCase ..> SkuQueries
    SkuQueries o-- DBConnector : pool
