%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class Orders {
        -order_id: text
        -marketplace_order_id: text
        -sales_channel: text
        -order_date: TIMESTAMPTZ
        -shipping_address: text
        -shipping_method: text
        -order_status: text
        -rsl_no: text
        -rsl_matched_at: TIMESTAMPTZ
        -tracking_number: text
        -carrier_name: text
        -dispatched_at: TIMESTAMPTZ
        -tracking_notified: BOOLEAN
        -tracking_notified_at: TIMESTAMPTZ
        -cancel_reason: text
        -cancelled_at: TIMESTAMPTZ
        -verified_at: TIMESTAMPTZ
        -created_at: TIMESTAMPTZ
        -updated_at: TIMESTAMPTZ
        -manual_reason: text
        -customer_cancel_requested: BOOLEAN
        -edit_log: jsonb
        -reorder_decision: text
        -decided_qty: INTEGER
        -delivery_status: text
        -reorder_id: text
        +create()
        +find()
        +update()
        +delete()
        +changeStatus(status)
    }
    class OrderItems {
        -order_item_id: text
        -channel_sku: text
        -variation: text
        -qty: INTEGER
        -fulfill_source: text
        -stock_deducted: BOOLEAN
        -deducted_at: TIMESTAMPTZ
        -order_id: text
        -sku_id: text
        +create()
        +find()
        +update()
    }
    class Labels {
        -label_id: text
        -label_template: text
        -rsl_no: text
        -parcel_seq: INTEGER
        -parcel_total: INTEGER
        -label_status: text
        -created_at: TIMESTAMPTZ
        -printed_at: TIMESTAMPTZ
        -order_id: text
        +create()
        +find()
        +update()
        +delete()
    }
    class DeletionHistory {
        -deletion_history_id: text
        -order_reference: text
        -order_snapshot: jsonb
        -admin_id: text
        -deleted_at: TIMESTAMPTZ
        +create()
        +find()
    }
    class TrackingNotificationLogs {
        -tracking_notification_log_id: text
        -order_id: text
        -tracking_number: text
        -outcome: text
        -sent_at: TIMESTAMPTZ
        -admin_id: text
        -attempt_id: text
        -error_code: text
        +create()
        +find()
        +update()
    }
    class LabelPrintHistory {
        -label_print_history_id: text
        -print_attempt_id: text
        -label_id: text
        -admin_id: text
        -is_reprint: BOOLEAN
        -outcome: text
        -error_code: text
        -attempted_at: TIMESTAMPTZ
        +create()
    }
    Reorders "1" -- "0..*" Orders
    Orders "1" -- "0..*" OrderItems
    Skus "1" -- "0..*" OrderItems
    Orders "1" -- "0..*" Costs
    Orders "1" -- "0..*" Labels
    Admins "1" -- "0..*" DeletionHistory
    Orders "1" -- "0..*" TrackingNotificationLogs
    Admins "1" -- "0..*" TrackingNotificationLogs
    Labels "1" -- "0..*" LabelPrintHistory
    Admins "1" -- "0..*" LabelPrintHistory
