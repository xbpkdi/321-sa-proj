%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class AppShellScreen {
        <<Screen>>
        +clickLogout()
        +confirmLogout()
        +openProtectedPage()
        +redirect()
        +showConfirm()
        +showLoginPage()
        +showMessage()
        +showPage()
    }
    class LoginScreen {
        <<Screen>>
        +openLoginPage()
        +redirect()
        +showDashboard()
        +showError()
        +showLoginForm()
        +submitLogin()
    }
    class LoginController {
        <<Controller>>
        +loginAction()
        +logoutAction()
        +requireSession()
        +validateInput()
        +verifyPassword()
    }
    class SessionAuth {
        -client: PoolClient
        +createSessionRecord()
        +deleteCookie()
        +getSession()
        +revokeCurrentSession()
        +setSessionCookie()
    }
    class AdminQueries {
        <<module>>
        +Q1A_1: SQL
        +Q1A_2: SQL
        +Q1A_2_UNLOCK: SQL
        +Q1A_3: SQL
        +findAdminByEmail()
        +recordFailedLogin()
        +recordSuccessfulLogin()
        +unlockAdmin()
    }
    class SessionQueries {
        <<module>>
        +Q1A_4: SQL
        +Q1A_5: SQL
        +Q1A_6: SQL
        +findActiveSession()
        +insertSession()
        +revokeSession()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    AppShellScreen "1" --> "1" LoginController : calls
    LoginScreen "1" --> "1" LoginController : calls
    LoginController ..> AdminQueries
    LoginController ..> SessionAuth
    SessionAuth ..> SessionQueries
    AdminQueries o-- DBConnector : pool
    SessionQueries o-- DBConnector : pool
