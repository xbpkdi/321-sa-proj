stateDiagram-v2
    direction LR
    state "Order (order_status) แจ้งเลขติดตามและตัดสต๊อก" as Order {
        direction LR
        state "Order.รอดำเนินการด้วยตนเอง" as s2
        state "Order.อยู่ระหว่างจัดส่ง" as s15
        state "Order.แจ้งเลขติดตามแล้ว" as s17
        state "Order.รอแจ้งเลขติดตาม" as s18
        state "Order.จัดส่งไม่สำเร็จ" as s19
        state "Order.ตีกลับ/คืนสินค้า" as s20
        state "Order.รอดำเนินการพิเศษ" as s21
        state "Order.จัดส่งสำเร็จ" as s22
        [*] --> s15 : ต่อจากรูปก่อนหน้า (ส่งมอบแล้ว)
        s15 --> s17 : [Rakuten รับเลขติดตาม] notifyTracking / ส่งเลขติดตามสินค้าของ Delivery ให้ลูกค้าผ่าน Marketplace (Q5S.4)
        s15 --> s18 : [ส่งเลขไม่สำเร็จ] notifyTracking / ส่งเลขติดตามสินค้าของ Delivery ให้ลูกค้าผ่าน Marketplace (Q5S.4)
        s18 --> s17 : [ส่งซ้ำสำเร็จ] notifyTracking / ส่งเลขติดตามสินค้าของ Delivery ให้ลูกค้าผ่าน Marketplace (Q5S.4)
        s15 --> s19 : [ขนส่งแจ้ง failed] pollCarrier / จัดส่งสินค้าให้ลูกค้าผ่าน Delivery (Q8A.4)
        s15 --> s20 : [ขนส่งแจ้ง returned] pollCarrier / จัดส่งสินค้าให้ลูกค้าผ่าน Delivery (Q8A.4)
        s15 --> s21 : [ขอยกเลิกหลังส่งมอบ] cancelOrder / ยกเลิก Order (Q7A.2)
        s17 --> s2 : [ตัดสต๊อกไม่ได้] deductStock / ตัดสต๊อกสินค้า (Q7S.3)
        s17 --> s22 : [delivered และแจ้งเลขแล้ว และตัดสต๊อกครบทุกรายการ] deductStock / ตัดสต๊อกสินค้า (Q7S.7)
        s22 --> [*] : deleteOldData / ลบข้อมูลเก่าที่ไม่ใช้แล้ว (Q10A.1)
    }
