%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class CancelOrderScreen {
        <<Screen>>
        +checkCancel()
        +clickCancel()
        +confirmCancel()
        +openCancelList()
        +showCancelDialog()
        +showError()
        +showOrders()
        +showSuccess()
    }
    class OrderVerifyScreen {
        <<Screen>>
        +clickConfirm()
        +openVerifyPage()
        +selectOrder()
        +showError()
        +showOrderDetail()
        +showOrdersWaitingVerify()
        +showSuccess()
    }
    class CancelOrderController {
        <<Controller>>
        +cancelOrderAction()
    }
    class OrderVerifyController {
        <<Controller>>
        +loadAppState()
        +verifyOrderAction()
    }
    class CancelOrderUseCase {
        -client: PoolClient
        +cancelOrderUseCase()
    }
    class ExecuteWorkflow {
        -client: PoolClient
        +executeWorkflow()
        +runAutomation()
    }
    class VerifyOrderUseCase {
        -client: PoolClient
        +verifyOrderUseCase()
    }
    class OrderQueries {
        <<module>>
        +Q2A_1: SQL
        +Q2A_1_FOR_UPDATE: SQL
        +Q2A_2: SQL
        +Q7A_1: SQL
        +Q7A_1_CANCEL_REORDER: SQL
        +Q7A_1_RELEASE_ORDERS: SQL
        +cancelLinkedReorder()
        +listOrders()
        +lockOrder()
        +saveCancellation()
        +saveVerifiedOrder()
    }
    class StockQueries {
        <<module>>
        +Q7A_2: SQL
        +restoreCancelledOrderStock()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    class RakutenAdapter {
        <<interface>>
        +fetchOrderState()
    }
    class MockAdapters {
        <<mock.ts>>
        -faults: FaultFlags
    }
    CancelOrderScreen "1" --> "1" CancelOrderController : calls
    OrderVerifyScreen "1" --> "1" OrderVerifyController : calls
    CancelOrderController ..> CancelOrderUseCase
    OrderVerifyController ..> OrderQueries
    OrderVerifyController ..> VerifyOrderUseCase
    CancelOrderUseCase ..> OrderQueries
    CancelOrderUseCase ..> StockQueries
    ExecuteWorkflow ..> OrderQueries
    ExecuteWorkflow ..> StockQueries
    VerifyOrderUseCase ..> ExecuteWorkflow
    VerifyOrderUseCase ..> OrderQueries
    VerifyOrderUseCase ..> RakutenAdapter
    OrderQueries o-- DBConnector : pool
    StockQueries o-- DBConnector : pool
    RakutenAdapter <|.. MockAdapters
