%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class ShippingScreen {
        <<Screen>>
        +clickDispatch()
        +clickNotify()
        +confirmDispatch()
        +openShippingPage()
        +showCarrierEvents()
        +showConfirmDialog()
        +showDispatchQueue()
        +showError()
        +showResendDialog()
        +showResult()
        +showShippedOrders()
        +showSuccess()
    }
    class ShippingController {
        <<Controller>>
        +dispatchOrdersAction()
        +notifyTrackingAction()
        +pollCarrierAction()
    }
    class DispatchOrderUseCase {
        -client: PoolClient
        +dispatchOrdersUseCase()
    }
    class ExecuteWorkflow {
        -client: PoolClient
        +executeWorkflow()
        +runAutomation()
    }
    class NotifyTrackingUseCase {
        -client: PoolClient
        +notify()
        +notifyTrackingUseCase()
    }
    class PollCarrierUseCase {
        -client: PoolClient
        +pollCarrierUseCase()
    }
    class ShippingQueries {
        <<module>>
        +Q5S_1: SQL
        +Q5S_1_ATTEMPT: SQL
        +Q5S_1_RETRY: SQL
        +Q5S_2: SQL
        +Q8A_1: SQL
        +Q8A_1_DELIVERED: SQL
        +Q8A_1_POLL: SQL
        +Q8A_1_SAVE: SQL
        +Q8A_1_STATUS: SQL
        +Q8A_1_WAIT: SQL
        +completeDeliveredOrder()
        +completeNotificationAttempt()
        +findRetryableNotificationAttempt()
        +listCarrierPollOrders()
        +lockDispatchOrder()
        +lockNotificationOrder()
        +markAwaitingCarrier()
        +saveCarrierStatus()
        +saveDispatch()
        +saveNotificationAttempt()
    }
    class StockQueries {
        <<module>>
        +Q7A_2: SQL
        +restoreCancelledOrderStock()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    class CarrierAdapter {
        <<interface>>
        +getDeliveryStatus()
        +getTrackingInfo()
    }
    class RakutenAdapter {
        <<interface>>
        +notifyTracking()
    }
    class MockAdapters {
        <<mock.ts>>
        -faults: FaultFlags
    }
    ShippingScreen "1" --> "1" ShippingController : calls
    ShippingController ..> DispatchOrderUseCase
    ShippingController ..> NotifyTrackingUseCase
    ShippingController ..> PollCarrierUseCase
    DispatchOrderUseCase ..> CarrierAdapter
    DispatchOrderUseCase ..> ShippingQueries
    ExecuteWorkflow ..> NotifyTrackingUseCase
    ExecuteWorkflow ..> ShippingQueries
    ExecuteWorkflow ..> StockQueries
    NotifyTrackingUseCase ..> ExecuteWorkflow
    NotifyTrackingUseCase ..> RakutenAdapter
    NotifyTrackingUseCase ..> ShippingQueries
    PollCarrierUseCase ..> CarrierAdapter
    PollCarrierUseCase ..> ExecuteWorkflow
    PollCarrierUseCase ..> ShippingQueries
    ShippingQueries o-- DBConnector : pool
    StockQueries o-- DBConnector : pool
    CarrierAdapter <|.. MockAdapters
    RakutenAdapter <|.. MockAdapters
