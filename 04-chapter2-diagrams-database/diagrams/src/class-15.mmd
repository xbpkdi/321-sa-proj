classDiagram
    direction TB
    class Suppliers {
        -supplier_id: VARCHAR❨10❩
        -supplier_name: VARCHAR❨100❩
        -contact_info: VARCHAR❨150❩
        -lead_time: SMALLINT
    }
    class Products {
        -sku: VARCHAR❨20❩
        -product_name: VARCHAR❨150❩
        -variation: VARCHAR❨50❩
        -sales_channel: VARCHAR❨30❩
        -supplier_id: VARCHAR❨10❩
        -reorder_threshold: INTEGER
        -reorder_qty: INTEGER
        -selling_price: NUMERIC❨10,2❩
        -active: BOOLEAN
    }
    class SkuRules {
        -sku_rule_id: INTEGER
        -channel_sku: VARCHAR❨40❩
        -sales_channel: VARCHAR❨30❩
        -sku: VARCHAR❨20❩
        -variation: VARCHAR❨50❩
        -product_name: VARCHAR❨150❩
    }
    class Stock {
        -sku: VARCHAR❨20❩
        -variation: VARCHAR❨50❩
        -in_house_qty: INTEGER
        -rsl_qty: INTEGER
        -updated_at: TIMESTAMPTZ
    }
    class ProductCost {
        -sku: VARCHAR❨20❩
        -purchase_price: NUMERIC❨12,2❩
        -currency: CHAR❨3❩
        -exchange_rate: NUMERIC❨8,4❩
        -intl_freight: NUMERIC❨10,2❩
        -duty_fee: NUMERIC❨10,2❩
        -marketplace_fee: NUMERIC❨10,2❩
        -domestic_shipping: NUMERIC❨10,2❩
        -rsl_charge: NUMERIC❨10,2❩
        -order_qty: INTEGER
    }
    class CostCalculationLog {
        -cost_id: INTEGER
        -sku: VARCHAR❨20❩
        -unit_cost: NUMERIC❨10,2❩
        -calculated_at: TIMESTAMPTZ
        -calculated_by: VARCHAR❨10❩
    }
    class PurchaseOrders {
        -po_id: VARCHAR❨12❩
        -sku: VARCHAR❨20❩
        -supplier_id: VARCHAR❨10❩
        -order_qty: INTEGER
        -order_date: TIMESTAMPTZ
        -eta: TIMESTAMPTZ
        -status: VARCHAR❨20❩
    }
    class RslShipments {
        -rsl_order_id: VARCHAR❨20❩
        -rsl_sku: VARCHAR❨20❩
        -rsl_variation: VARCHAR❨50❩
        -rsl_stock_qty: INTEGER
    }
    Suppliers "1" -- "0..*" Products
    Products "1" -- "0..*" SkuRules
    Products "1" -- "1" Stock
    Products "1" -- "1" ProductCost
    Products "1" -- "0..*" CostCalculationLog
    Users "1" -- "0..*" CostCalculationLog
    Products "1" -- "0..*" PurchaseOrders
    Suppliers "1" -- "0..*" PurchaseOrders
    Products "1" -- "0..*" Orders
    SkuRules "1" -- "0..*" Orders
    PurchaseOrders "1" -- "0..*" Orders
    Products "1" -- "0..*" RslShipments
