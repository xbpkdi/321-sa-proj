%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction TB
    class Suppliers {
        -supplier_id: text
        -supplier_name: text
        -contact_info: text
        -lead_time_days: INTEGER
        -created_at: TIMESTAMPTZ
        +find()
    }
    class Skus {
        -sku_id: text
        -sku: text
        -product_name: text
        -variation: text
        -sales_channel: text
        -channel_sku: text
        -selling_price: NUMERIC❨14,2❩
        -reorder_threshold: INTEGER
        -reorder_qty: INTEGER
        -sku_status: text
        -created_at: TIMESTAMPTZ
        -supplier_id: text
        +create()
        +find()
        +update()
        +delete()
    }
    class Stock {
        -stock_id: text
        -in_house_qty: INTEGER
        -rsl_qty: INTEGER
        -updated_at: TIMESTAMPTZ
        -sku_id: text
        +create()
        +find()
        +update()
        +delete()
    }
    class Costs {
        -cost_id: text
        -purchase_price: NUMERIC❨14,4❩
        -currency: text
        -exchange_rate: NUMERIC❨14,6❩
        -intl_freight: NUMERIC❨14,4❩
        -duty_fee: NUMERIC❨14,4❩
        -marketplace_fee: NUMERIC❨14,4❩
        -domestic_shipping: NUMERIC❨14,4❩
        -rsl_charge: NUMERIC❨14,4❩
        -order_qty: INTEGER
        -unit_cost: NUMERIC❨14,4❩
        -calculated_at: TIMESTAMPTZ
        -sku_id: text
        -order_id: text
        -exchange_rate_updated_at: TIMESTAMPTZ
        +create()
        +find()
        +update()
        +delete()
    }
    class Reorders {
        -reorder_id: text
        -order_qty: INTEGER
        -decision: text
        -decided_at: TIMESTAMPTZ
        -reorder_status: text
        -ordered_at: TIMESTAMPTZ
        -expected_date: DATE
        -supplier_tracking_no: text
        -received_at: TIMESTAMPTZ
        -created_at: TIMESTAMPTZ
        -sku_id: text
        -supplier_id: text
        -supplier_request_id: text
        -supplier_reference: text
        -last_error_code: text
        -received_qty: INTEGER
        +create()
        +find()
        +update()
        +delete()
    }
    class RakutenStockSyncStates {
        -stock_id: text
        -sync_status: text
        -last_synced_qty: INTEGER
        -last_attempt_at: TIMESTAMPTZ
        -last_synced_at: TIMESTAMPTZ
        -last_error_code: text
        +create()
        +find()
        +update()
    }
    Suppliers "1" -- "0..*" Skus
    Skus "1" -- "1" Stock
    Reorders "1" -- "0..*" Orders
    Skus "1" -- "0..*" OrderItems
    Skus "1" -- "0..*" Costs
    Orders "1" -- "0..*" Costs
    Skus "1" -- "0..*" Reorders
    Suppliers "1" -- "0..*" Reorders
    Skus "1" -- "0..*" CostHistory
    Costs "1" -- "0..*" CostHistory
    Stock "1" -- "1" RakutenStockSyncStates
    Stock "1" -- "0..*" StockAdjustmentHistory
