%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class ReorderScreen {
        <<Screen>>
        +chooseDecision()
        +confirmDecision()
        +openDecideTab()
        +showConfirmDialog()
        +showDecisionList()
        +showError()
        +showSuccess()
    }
    class ReorderController {
        <<Controller>>
        +decideReorderAction()
    }
    class ReordersUseCase {
        -client: PoolClient
        +decideReorderUseCase()
    }
    class ReorderQueries {
        <<module>>
        +Q5A_1_FOR_UPDATE: SQL
        +Q5A_4: SQL
        +Q5A_4_MANUAL_PRICE: SQL
        +lockDecisionContext()
        +markDecisionMissingPrice()
        +saveReorderDecision()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    ReorderScreen "1" --> "1" ReorderController : calls
    ReorderController ..> ReorderQueries
    ReorderController ..> ReordersUseCase
    ReordersUseCase ..> ReorderQueries
    ReorderQueries o-- DBConnector : pool
