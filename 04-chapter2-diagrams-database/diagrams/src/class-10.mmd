%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class LabelPrintScreen {
        <<Screen>>
        +clickPrint()
        +openLabelPage()
        +showError()
        +showEvents()
        +showPrintQueue()
        +showReprintDialog()
        +showSuccess()
    }
    class LabelPrintController {
        <<Controller>>
        +formatLabelsAction()
        +loadAppState()
        +printLabelsAction()
    }
    class ExecuteWorkflow {
        -client: PoolClient
        +findLabelRule()
    }
    class FormatLabelsUseCase {
        -client: PoolClient
        +findLabelRule()
        +formatLabelsUseCase()
    }
    class PrintLabelUseCase {
        -client: PoolClient
        +printLabelUseCase()
        +printLabelsUseCase()
    }
    class AutoErrorLogQueries {
        <<module>>
        +Q_AUTO_ERROR_LOG: SQL
        +insertAutoErrorLog()
    }
    class OrderQueries {
        <<module>>
        +Q2A_1_FOR_UPDATE: SQL
        +lockOrder()
    }
    class ShippingQueries {
        <<module>>
        +Q6S_1: SQL
        +Q6S_2_ADVANCE: SQL
        +Q6S_2_ERROR: SQL
        +Q6S_2_INSERT: SQL
        +Q6S_2_MANUAL: SQL
        +Q9A_1: SQL
        +Q9A_1_PRINT: SQL
        +Q9A_2_COMPLETE: SQL
        +Q9A_2_HISTORY: SQL
        +completeLabelPrint()
        +listLabels()
        +listPendingLabelOrders()
        +listPrintableLabels()
        +markLabelManual()
        +recordLabelServiceError()
        +recordPrintAttempt()
        +saveGeneratedLabels()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    class LabelServiceAdapter {
        <<interface>>
        +generateLabels()
    }
    class PrinterAdapter {
        <<interface>>
        +printLabel()
    }
    class MockAdapters {
        <<mock.ts>>
        -faults: FaultFlags
    }
    LabelPrintScreen "1" --> "1" LabelPrintController : calls
    LabelPrintController ..> FormatLabelsUseCase
    LabelPrintController ..> PrintLabelUseCase
    LabelPrintController ..> ShippingQueries
    ExecuteWorkflow ..> AutoErrorLogQueries
    ExecuteWorkflow ..> LabelServiceAdapter
    ExecuteWorkflow ..> OrderQueries
    ExecuteWorkflow ..> ShippingQueries
    FormatLabelsUseCase ..> LabelServiceAdapter
    FormatLabelsUseCase ..> ShippingQueries
    PrintLabelUseCase ..> PrinterAdapter
    PrintLabelUseCase ..> ShippingQueries
    AutoErrorLogQueries o-- DBConnector : pool
    OrderQueries o-- DBConnector : pool
    ShippingQueries o-- DBConnector : pool
    LabelServiceAdapter <|.. MockAdapters
    PrinterAdapter <|.. MockAdapters
