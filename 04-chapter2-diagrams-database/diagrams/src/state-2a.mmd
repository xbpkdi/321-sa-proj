stateDiagram-v2
    direction LR
    state "Order (order_status) จับคู่ RSL และจัดรูปแบบใบปะ" as Order {
        direction LR
        state "Order.รอดำเนินการด้วยตนเอง" as s2
        state "Order.ยังไม่ได้จับคู่" as s6
        state "Order.รอจัดรูปแบบใบปะสินค้า" as s7
        state "Order.รอพิมพ์ใบปะสินค้า" as s13
        [*] --> s6 : ต่อจากรูปก่อนหน้า (RSL จัดส่ง)
        [*] --> s7 : ต่อจากรูปก่อนหน้า (บริษัทจัดส่งเอง)
        s6 --> s7 : [พบเลข RSL] matchRsl / จับคู่ Order กับเลข RSL (Q1S.3)
        s7 --> s13 : [สร้างใบปะสำเร็จ] formatLabels / จัดรูปแบบใบปะสินค้า (Q6S.5)
        s7 --> s2 : [ไม่พบ template] formatLabels / จัดรูปแบบใบปะสินค้า (Q6S.3)
        s7 --> s6 : [จับคู่ RSL ผิด] unmatchRsl / จับคู่ Order กับเลข RSL (Q1S.4)
        s2 --> s6 : [มีเลข RSL และจับคู่ผิด] unmatchRsl / จับคู่ Order กับเลข RSL (Q1S.4)
    }
