%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class CleanupScreen {
        <<Screen>>
        +clickBackup()
        +clickConfirmDelete()
        +clickReviewClosed()
        +downloadCsv()
        +openCleanupPage()
        +planClosedCleanup()
        +planRangeCleanup()
        +selectTypes()
        +showError()
        +showReview()
        +showSuccess()
        +showTabs()
        +showWarning()
    }
    class CleanupController {
        <<Controller>>
        +cleanupOrdersAction()
        +loadAppState()
    }
    class CleanupOrdersUseCase {
        -client: PoolClient
        +cleanupOrdersUseCase()
    }
    class CleanupQueries {
        <<module>>
        +Q10A_2_DELETE_COST: SQL
        +Q10A_3_DELETE_LABEL: SQL
        +Q10A_4_DELETE_REORDER: SQL
        +Q10A_5_DELETE_ORDER: SQL
        +Q10A_6: SQL
        +deleteClosedLabels()
        +deleteClosedOrder()
        +deleteFinishedReorder()
        +deleteHistoricalCost()
        +listDeletionHistory()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    CleanupScreen "1" --> "1" CleanupController : calls
    CleanupController ..> CleanupOrdersUseCase
    CleanupController ..> CleanupQueries
    CleanupOrdersUseCase ..> CleanupQueries
    CleanupQueries o-- DBConnector : pool
