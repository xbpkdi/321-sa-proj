%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class ReorderScreen {
        <<Screen>>
        +confirmReceive()
        +openPurchaseTab()
        +purchase()
        +purchaseQueue()
        +receive()
        +showDuplicateConfirm()
        +showError()
        +showPurchaseQueue()
        +showReceiveDialog()
        +showSuccess()
    }
    class ReorderController {
        <<Controller>>
        +loadAppState()
        +purchaseReorderAction()
        +receiveReorderAction()
    }
    class ExecuteWorkflow {
        -client: PoolClient
        +executeWorkflow()
        +runAutomation()
    }
    class ReordersUseCase {
        -client: PoolClient
        +purchaseReorderUseCase()
        +receiveReorderUseCase()
    }
    class ReorderQueries {
        <<module>>
        +Q5A_1: SQL
        +Q6A_10_FOR_UPDATE: SQL
        +Q6A_11_RECEIVE: SQL
        +Q6A_12_RELEASE_ORDERS: SQL
        +Q6A_1_COMPLETE: SQL
        +Q6A_1_INSERT: SQL
        +Q6A_1_MARK_ORDERS: SQL
        +Q6A_1_NEXT_NUMBER: SQL
        +Q6A_1_PENDING: SQL
        +Q6A_1_RETRY: SQL
        +Q6A_2_FOR_UPDATE: SQL
        +completeReorderAttempt()
        +findPendingReorder()
        +findRetryReorder()
        +insertReorderAttempt()
        +listReorders()
        +lockPurchaseContext()
        +lockReceiveContext()
        +markLinkedReorderOrders()
        +markReorderReceived()
        +nextReorderNumber()
        +releaseReceivedOrders()
    }
    class SkuQueries {
        <<module>>
        +Q6A_2: SQL
        +listSuppliers()
    }
    class StockQueries {
        <<module>>
        +Q3S_1_ADJUST: SQL
        +Q3S_1_INSERT_HISTORY: SQL
        +adjustStock()
        +insertStockAdjustmentHistory()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    class SupplierAdapter {
        <<interface>>
        +sendPurchaseOrder()
    }
    class MockAdapters {
        <<mock.ts>>
        -faults: FaultFlags
    }
    ReorderScreen "1" --> "1" ReorderController : calls
    ReorderController ..> ReorderQueries
    ReorderController ..> ReordersUseCase
    ReorderController ..> SkuQueries
    ExecuteWorkflow ..> ReorderQueries
    ExecuteWorkflow ..> StockQueries
    ReordersUseCase ..> ExecuteWorkflow
    ReordersUseCase ..> ReorderQueries
    ReordersUseCase ..> SupplierAdapter
    ReorderQueries o-- DBConnector : pool
    SkuQueries o-- DBConnector : pool
    StockQueries o-- DBConnector : pool
    SupplierAdapter <|.. MockAdapters
