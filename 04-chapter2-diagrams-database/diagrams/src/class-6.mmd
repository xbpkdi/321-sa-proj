%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class CostScreen {
        <<Screen>>
        +calculate()
        +openCostPage()
        +selectProduct()
        +showCostForm()
        +showError()
        +showProductList()
        +showResult()
        +showWarning()
    }
    class CostController {
        <<Controller>>
        +calculateCostAction()
        +loadAppState()
    }
    class CostsUseCase {
        -client: PoolClient
        +calcUnitCost()
        +calculateCostUseCase()
        +parseCostForm()
        +saveCostDraft()
    }
    class CostHistoryQueries {
        <<module>>
        +Q4S_2_HISTORY: SQL
        +Q4S_2_INSERT_HISTORY: SQL
        +insertCostHistory()
        +listCostHistory()
    }
    class CostQueries {
        <<module>>
        +Q4S_1: SQL
        +Q4S_1_FOR_UPDATE: SQL
        +Q4S_1_SELLING_PRICE: SQL
        +Q4S_2_SAVE: SQL
        +getSkuSellingPrice()
        +listCosts()
        +lockCost()
        +saveCost()
    }
    class SkuQueries {
        <<module>>
        +Q3A_1_FOR_UPDATE: SQL
        +lockSku()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    CostScreen "1" --> "1" CostController : calls
    CostController ..> CostHistoryQueries
    CostController ..> CostQueries
    CostController ..> CostsUseCase
    CostsUseCase ..> CostHistoryQueries
    CostsUseCase ..> CostQueries
    CostsUseCase ..> SkuQueries
    CostHistoryQueries o-- DBConnector : pool
    CostQueries o-- DBConnector : pool
    SkuQueries o-- DBConnector : pool
