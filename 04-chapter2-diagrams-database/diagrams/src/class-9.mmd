%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction LR
    class RslMatchScreen {
        <<Screen>>
        +clickMatch()
        +clickMatchAll()
        +clickUnmatch()
        +openRslMatchPage()
        +showChooseDialog()
        +showError()
        +showSuccess()
        +showUnmatchedOrders()
    }
    class RslMatchController {
        <<Controller>>
        +matchAllRslAction()
        +matchRslAction()
        +unmatchRslAction()
    }
    class ExecuteWorkflow {
        -client: PoolClient
        +executeWorkflow()
        +runAutomation()
    }
    class MatchOrderUseCase {
        -client: PoolClient
        +chooseRslMatch()
        +matchAllRslUseCase()
        +matchRslUseCase()
        +unmatchRslUseCase()
    }
    class OrderQueries {
        <<module>>
        +Q1S_1: SQL
        +Q1S_1_QUEUE: SQL
        +Q1S_1_UNMATCH: SQL
        +Q2A_1_FOR_UPDATE: SQL
        +clearRslMatch()
        +listRslQueueIds()
        +lockOrder()
        +saveRslMatch()
    }
    class DBConnector {
        -pool: Pool
        +query()
    }
    class RslAdapter {
        <<interface>>
        +matchOrder()
    }
    class MockAdapters {
        <<mock.ts>>
        -faults: FaultFlags
    }
    RslMatchScreen "1" --> "1" RslMatchController : calls
    RslMatchController ..> MatchOrderUseCase
    ExecuteWorkflow ..> OrderQueries
    MatchOrderUseCase ..> ExecuteWorkflow
    MatchOrderUseCase ..> OrderQueries
    MatchOrderUseCase ..> RslAdapter
    OrderQueries o-- DBConnector : pool
    RslAdapter <|.. MockAdapters
