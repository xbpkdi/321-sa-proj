%%{init: {'class': {'hideEmptyMembersBox': true}, 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    direction TB
    class Admins {
        -admin_id: text
        -user_email: text
        -user_password: text
        -fail_attempts: INTEGER
        -last_login: TIMESTAMPTZ
        -created_at: TIMESTAMPTZ
        -locked_until: TIMESTAMPTZ
        +find()
        +update()
    }
    class Sessions {
        -session_id: text
        -admin_id: text
        -token_hash: text
        -created_at: TIMESTAMPTZ
        -expires_at: TIMESTAMPTZ
        -revoked_at: TIMESTAMPTZ
        +create()
        +find()
        +update()
    }
    class AutoErrorLogs {
        -auto_error_log_id: text
        -use_case_id: text
        -context_key: text
        -error_code: text
        -safe_message: text
        -occurred_at: TIMESTAMPTZ
        +create()
    }
    class CostHistory {
        -cost_history_id: text
        -sku_id: text
        -cost_id: text
        -previous_value: jsonb
        -new_value: jsonb
        -admin_id: text
        -changed_at: TIMESTAMPTZ
        +create()
        +find()
        +update()
        +delete()
    }
    class StockAdjustmentHistory {
        -stock_adjustment_history_id: text
        -stock_id: text
        -previous_in_house_qty: INTEGER
        -new_in_house_qty: INTEGER
        -previous_rsl_qty: INTEGER
        -new_rsl_qty: INTEGER
        -reason: text
        -admin_id: text
        -adjusted_at: TIMESTAMPTZ
        +create()
    }
    Admins "1" -- "0..*" Sessions
    Admins "1" -- "0..*" DeletionHistory
    Skus "1" -- "0..*" CostHistory
    Costs "1" -- "0..*" CostHistory
    Admins "1" -- "0..*" CostHistory
    Admins "1" -- "0..*" TrackingNotificationLogs
    Stock "1" -- "0..*" StockAdjustmentHistory
    Admins "1" -- "0..*" StockAdjustmentHistory
    Admins "1" -- "0..*" LabelPrintHistory
